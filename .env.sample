# Copy to .env and adjust. NEVER commit .env.
# All variables use the SCOUT_ prefix (see src/mlx_model_scout/config/settings.py).

# --- Local LLM: OpenAI-compatible MLX server on the macOS host ---
# Reference setup: omlx on port 8000 (requires an API key, set in omlx).
# Alternative: `make mlx-server` (mlx_lm.server on the same port, ignores the key).
SCOUT_LLM_BASE_URL=http://127.0.0.1:8000/v1
SCOUT_LLM_API_KEY=your-omlx-api-key
# Must match an id from GET /v1/models exactly. omlx lists models WITHOUT the
# "mlx-community/" prefix; mlx_lm.server uses the full HF repo id.
SCOUT_LLM_MODEL=Qwen3-30B-A3B-Instruct-2507-4bit

# --- Hugging Face (optional; public API works without a token) ---
# Create a read-only token at https://huggingface.co/settings/tokens to raise rate limits.
# A fake token causes HTTP 401 - leave commented out unless you have a real one.
# SCOUT_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SCOUT_HF_AUTHORS=["mlx-community"]
SCOUT_HF_SCAN_LIMIT=50

# --- Server ---
# stdio (Cursor / local client) | http (container)
SCOUT_TRANSPORT=stdio
SCOUT_HTTP_HOST=127.0.0.1
SCOUT_HTTP_PORT=8765
# DNS-rebinding protection for the HTTP transport (default: loopback only). Change only behind a proxy.
# SCOUT_HTTP_ALLOWED_HOSTS=["127.0.0.1", "127.0.0.1:*", "localhost", "localhost:*", "[::1]", "[::1]:*"]
SCOUT_LOG_LEVEL=INFO

# --- Persistence / audit logging ---
SCOUT_DB_PATH=./data/scout.db
# false = store truncated prompts + SHA-256 only; true = full prompts/responses in SQLite
SCOUT_LOG_FULL_MESSAGES=false
SCOUT_LOG_TRUNCATE_CHARS=500
SCOUT_LOG_RETENTION_DAYS=30
# WAL journal; set false when the DB is shared across container VMs (see compose.yaml)
SCOUT_DB_WAL=true

# --- Container only: LLM server address as seen from inside the container ---
SCOUT_LLM_BASE_URL_CONTAINER=http://host.docker.internal:8000/v1
